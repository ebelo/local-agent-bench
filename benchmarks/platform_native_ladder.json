{
  "name": "platform-native-ladder",
  "description": "Harder candid user-facing platform-native tasks for probing levels 6-8 of the capability ladder. Prompts are ordinary user requests; scoring checks whether the runtime solved the use case.",
  "tasks": [
    {
      "id": "level6_github_repo_grounding",
      "category": "level6_web_grounding",
      "prompt": "What is the GitHub repository full name and default branch for https://github.com/ebelo/local-agent-bench?",
      "requires_network": true,
      "diagnostic_layer": "platform_native_ladder_level_6",
      "assertions": [
        {
          "type": "answer_contains_all",
          "values": [
            "ebelo/local-agent-bench",
            "main"
          ]
        }
      ]
    },
    {
      "id": "level6_weather_compare_live",
      "category": "level6_web_grounding",
      "prompt": "Which is warmer right now, Berlin or Zurich?",
      "requires_network": true,
      "diagnostic_layer": "platform_native_ladder_level_6",
      "assertions": [
        {
          "type": "answer_contains_any",
          "values": [
            "Berlin"
          ]
        },
        {
          "type": "answer_contains_any",
          "values": [
            "Zurich",
            "Zürich"
          ]
        },
        {
          "type": "answer_contains_any",
          "values": [
            "warmer",
            "higher",
            "hotter"
          ]
        },
        {
          "type": "answer_matches_regex",
          "pattern": "([+-]?\\d{1,2}(?:\\.\\d+)?)\\s?(?:°\\s?C|Celsius|degrees Celsius|\\bC\\b)"
        },
        {
          "type": "answer_matches_open_meteo_current",
          "latitude": 52.52,
          "longitude": 13.405,
          "timezone": "Europe/Berlin",
          "field": "temperature_2m",
          "tolerance": 3.0,
          "critical": true
        },
        {
          "type": "answer_matches_open_meteo_current",
          "latitude": 47.3769,
          "longitude": 8.5417,
          "timezone": "Europe/Zurich",
          "field": "temperature_2m",
          "tolerance": 3.0,
          "critical": true
        },
        {
          "type": "answer_not_contains_any",
          "values": [
            "Mots-clés",
            "Keywords",
            "${",
            "javascript:",
            "\"current_units\"",
            "\"current\"",
            "we can use",
            "I'll search",
            "Let's first",
            "assuming",
            "provided code",
            "This command fetches",
            "will leverage"
          ],
          "critical": true
        }
      ]
    },
    {
      "id": "level6_remote_readme_cross_check",
      "category": "level6_web_grounding",
      "prompt": "Does the live README for ebelo/local-agent-bench say level 8 is end-to-end agent work?",
      "requires_network": true,
      "diagnostic_layer": "platform_native_ladder_level_6",
      "assertions": [
        {
          "type": "answer_contains_all",
          "values": [
            "Level 8",
            "End-to-end agent work"
          ]
        }
      ]
    },
    {
      "id": "level7_html_link_navigation",
      "category": "level7_navigation",
      "prompt": "Open benchmarks/native_nav/index.html, follow the links to the final page, and tell me the navigation passphrase.",
      "diagnostic_layer": "platform_native_ladder_level_7",
      "assertions": [
        {
          "type": "answer_contains_all",
          "values": [
            "violet-harbor"
          ]
        }
      ]
    },
    {
      "id": "level7_markdown_link_navigation",
      "category": "level7_navigation",
      "prompt": "Read benchmarks/native_nav/start.md, follow the Markdown links to the terminal note, and tell me the navigation code.",
      "diagnostic_layer": "platform_native_ladder_level_7",
      "assertions": [
        {
          "type": "answer_contains_all",
          "values": [
            "delta-17"
          ]
        }
      ]
    },
    {
      "id": "level8_release_readiness_brief",
      "category": "level8_end_to_end",
      "prompt": "Can you give me a release-readiness brief for this project, including the codename, release window, deployment color, current Zurich weather, and a go/no-go recommendation?",
      "requires_network": true,
      "diagnostic_layer": "platform_native_ladder_level_8",
      "assertions": [
        {
          "type": "answer_contains_all",
          "values": [
            "alpine-signal",
            "2026-Q3",
            "teal"
          ]
        },
        {
          "type": "answer_contains_any",
          "values": [
            "Zurich",
            "Zürich"
          ]
        },
        {
          "type": "answer_contains_any",
          "values": [
            "go",
            "no-go",
            "recommendation"
          ]
        },
        {
          "type": "answer_matches_regex",
          "pattern": "([+-]?\\d{1,2}(?:\\.\\d+)?)\\s?(?:°\\s?C|Celsius|degrees Celsius|\\bC\\b)"
        },
        {
          "type": "answer_matches_open_meteo_current",
          "latitude": 47.3769,
          "longitude": 8.5417,
          "timezone": "Europe/Zurich",
          "field": "temperature_2m",
          "tolerance": 3.0,
          "critical": true
        },
        {
          "type": "answer_not_contains_any",
          "values": [
            "Mots-clés",
            "Keywords",
            "${",
            "javascript:",
            "\"current_units\"",
            "\"current\"",
            "we can use",
            "I'll search",
            "Let's first",
            "assuming",
            "provided code",
            "This command fetches",
            "will leverage"
          ],
          "critical": true
        }
      ]
    },
    {
      "id": "level8_test_and_summarize",
      "category": "level8_end_to_end",
      "prompt": "Can you do a quick project-health check: what is the package name, are there runtime dependencies, do the tests pass, and what is your recommendation?",
      "diagnostic_layer": "platform_native_ladder_level_8",
      "assertions": [
        {
          "type": "answer_contains_all",
          "values": [
            "local-agent-bench",
            "pytest"
          ]
        },
        {
          "type": "answer_contains_any",
          "values": [
            "44 passed",
            "passed"
          ]
        }
      ]
    }
  ]
}
